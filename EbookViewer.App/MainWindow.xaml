<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EbookViewer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EbookViewer.App"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="EbookViewer">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False" OverflowButtonVisibility="Auto"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="開く" Click="OpenButton_Click" ToolTipService.ToolTip="ファイルを開く (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="RecentButton" Icon="Clock" Label="最近" ToolTipService.ToolTip="最近開いたファイル">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="RecentFlyout" Opening="RecentFlyout_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarToggleButton x:Name="TocToggle" Icon="List" Label="目次" Click="TocToggle_Click" ToolTipService.ToolTip="目次の表示 (Ctrl+T)">
                <AppBarToggleButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="T" Modifiers="Control" />
                </AppBarToggleButton.KeyboardAccelerators>
            </AppBarToggleButton>
            <AppBarSeparator />
            <AppBarButton x:Name="PrevButton" Icon="Previous" Label="前へ" Click="PrevButton_Click" ToolTipService.ToolTip="前のページ" />
            <AppBarButton x:Name="NextButton" Icon="Next" Label="次へ" Click="NextButton_Click" ToolTipService.ToolTip="次のページ" />
            <AppBarSeparator />
            <AppBarButton x:Name="WritingModeButton" Label="縦書き" Click="WritingModeButton_Click" ToolTipService.ToolTip="組方向の切り替え (自動 → 縦書き → 横書き)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8D2;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="FontDownButton" Icon="FontDecrease" Label="小" Click="FontDownButton_Click" ToolTipService.ToolTip="文字を小さく (Ctrl+-)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Subtract" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="FontUpButton" Icon="FontIncrease" Label="大" Click="FontUpButton_Click" ToolTipService.ToolTip="文字を大きく (Ctrl++)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Add" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="DisplayButton" Icon="Setting" Label="表示" ToolTipService.ToolTip="テーマ・フォント・行間">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutSubItem Text="テーマ">
                            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="明るい" GroupName="theme" Tag="light" Click="ThemeItem_Click" />
                            <RadioMenuFlyoutItem x:Name="ThemeSepia" Text="セピア" GroupName="theme" Tag="sepia" Click="ThemeItem_Click" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="暗い" GroupName="theme" Tag="dark" Click="ThemeItem_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="フォント">
                            <RadioMenuFlyoutItem x:Name="FontMincho" Text="明朝" GroupName="font" Tag="mincho" Click="FontItem_Click" />
                            <RadioMenuFlyoutItem x:Name="FontGothic" Text="ゴシック" GroupName="font" Tag="gothic" Click="FontItem_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="行間">
                            <RadioMenuFlyoutItem x:Name="LineHeight16" Text="狭い (1.6)" GroupName="lh" Tag="1.6" Click="LineHeightItem_Click" />
                            <RadioMenuFlyoutItem x:Name="LineHeight19" Text="標準 (1.9)" GroupName="lh" Tag="1.9" Click="LineHeightItem_Click" />
                            <RadioMenuFlyoutItem x:Name="LineHeight22" Text="広い (2.2)" GroupName="lh" Tag="2.2" Click="LineHeightItem_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="余白">
                            <RadioMenuFlyoutItem x:Name="Padding16" Text="狭い" GroupName="pad" Tag="16" Click="PaddingItem_Click" />
                            <RadioMenuFlyoutItem x:Name="Padding36" Text="標準" GroupName="pad" Tag="36" Click="PaddingItem_Click" />
                            <RadioMenuFlyoutItem x:Name="Padding64" Text="広い" GroupName="pad" Tag="64" Click="PaddingItem_Click" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <SplitView x:Name="Split" Grid.Row="1" DisplayMode="Inline" OpenPaneLength="320" IsPaneOpen="False"
                   PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Padding="16,12,16,8" Spacing="2">
                        <TextBlock x:Name="PaneTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" Text="目次" />
                        <TextBlock x:Name="PaneAuthor" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                    <ListView x:Name="TocList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TocList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TocItem">
                                <TextBlock Text="{x:Bind Title}" Margin="{x:Bind Margin}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </SplitView.Pane>

            <Grid x:Name="ContentHost">
                <controls:WebView2 x:Name="Web" Visibility="Collapsed" />

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480">
                    <Image Source="ms-appx:///Assets/app-icon.png" Width="112" Height="112" HorizontalAlignment="Center" />
                    <TextBlock Text="電子書籍ビューアー" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8"
                               Text="EPUB / MOBI / AZW3 ファイルをここにドロップするか、「開く」から選択してください。日本語の本は縦書きで表示されます。" />
                    <Button Content="ファイルを開く…" HorizontalAlignment="Center" Click="OpenButton_Click" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="ページ送り: ← → / PageUp PageDown / スペース / マウスホイール / 画面の左右端をクリック" />
                </StackPanel>

                <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="48" Height="48" />
                        <TextBlock x:Name="LoadingText" Text="読み込み中…" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </SplitView>

        <Grid Grid.Row="2" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLeft" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusRight" Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>
