<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EbookViewer.Core</RootNamespace>
    <AssemblyName>EbookViewer.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ビューアーが本文 HTML に注入する CSS / JS。埋め込みリソースとして同梱する -->
    <EmbeddedResource Include="Rendering\Assets\viewer.css" LogicalName="viewer.css" />
    <EmbeddedResource Include="Rendering\Assets\viewer.js" LogicalName="viewer.js" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>EbookViewer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
